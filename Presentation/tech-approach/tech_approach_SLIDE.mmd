flowchart LR

  subgraph S1["<b>① CAPTURE</b>"]
    direction LR
    EXT("<b>Browser extension</b><br/><span class='tech'>Chrome MV3 · React</span>")
    DASH("<b>Analyst dashboard</b><br/><span class='tech'>Next.js 16 · React 19</span>")
    API("<b>REST API</b><br/><span class='tech'>FastAPI · SSE</span>")
  end

  subgraph S2["<b>② TRIAGE</b>"]
    direction TB
    ROUTER("<b>Router</b><br/>blocklist + 24 h cache<br/><span class='tech'>SQLite</span>")
    QUICK("<b>Quick ML check</b><br/>no LLM call<br/><span class='tech'>ONNX · BERT</span>")
    ROUTER --> QUICK
  end

  subgraph S3["<b>③ FORENSICS</b>"]
    direction LR
    F1("<b>1 · Header trace</b><br/><span class='tech'>Python email</span>")
    F2("<b>2 · SPF · DKIM · DMARC</b><br/><span class='tech'>checkdmarc · dkimpy</span>")
    F3("<b>3 · Domain intel</b><br/><span class='tech'>WHOIS · dnspython</span>")
    F4("<b>4 · Origin IP + TOR/VPN</b><br/><span class='tech'>GeoLite2 · AbuseIPDB</span>")
    F5("<b>5 · Attachment scan</b><br/><span class='tech'>oletools · ClamAV</span>")
  end

  subgraph S4["<b>④ AI INVESTIGATION</b>"]
    direction TB
    AGENT("<b>LangGraph agent</b><br/><span class='techw'>LLM via OpenRouter</span>")
    TOOLS("<b>7 tools</b><br/>Sandbox browser · <span class='tech'>Playwright</span><br/>Reputation · <span class='tech'>WHOIS, VirusTotal</span><br/>Phishing model · <span class='tech'>BERT</span><br/>Case memory · <span class='tech'>SecureBERT</span><br/>Geo · Correlation · Search")
    AGENT <--> TOOLS
  end

  subgraph S5["<b>⑤ VERDICT & ACTION</b>"]
    direction TB
    RULES("<b>Rule engine</b><br/>risk 0–100 + a reason per point<br/>5 labels · attribution")
    OUT("<b>Outputs</b><br/>Alert & block · <span class='tech'>extension</span><br/>Origin map · <span class='tech'>Leaflet</span><br/>Campaign graph · <span class='tech'>NetworkX, DBSCAN</span><br/>Forensic PDF · <span class='tech'>jsPDF</span>")
    DATA[("<b>Store & protect</b><br/>History · <span class='tech'>SQLite</span><br/>PII masking · <span class='tech'>Presidio</span><br/>SHA-256 evidence<br/>90-day auto-delete")]
    RULES --> OUT --> DATA
  end

  S1 ==> S2 ==> S3 ==> S4 ==> S5
  S2 -.->|"known threat → instant verdict"| S5

  classDef cap   fill:#FFFFFF,stroke:#2B6CB0,stroke-width:3px,color:#1F2A44
  classDef tri   fill:#FFFFFF,stroke:#9A7300,stroke-width:3px,color:#1F2A44
  classDef forn  fill:#FFFFFF,stroke:#C0394B,stroke-width:3px,color:#1F2A44
  classDef ai    fill:#FFFFFF,stroke:#5B4BC4,stroke-width:3px,color:#1F2A44
  classDef aiHot fill:#5B4BC4,stroke:#5B4BC4,stroke-width:3px,color:#FFFFFF
  classDef out   fill:#FFFFFF,stroke:#2E8B62,stroke-width:3px,color:#1F2A44
  classDef outHot fill:#2E8B62,stroke:#2E8B62,stroke-width:3px,color:#FFFFFF
  classDef store fill:#F3F5F9,stroke:#5A6378,stroke-width:3px,color:#1F2A44
  class EXT,DASH,API cap
  class ROUTER,QUICK tri
  class F1,F2,F3,F4,F5 forn
